// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model Tenant {
  id               String   @id @default(uuid())
  name             String
  email            String   @unique
  subscriptionPlan String?  @map("subscription_plan") // 'basic', 'pro', 'enterprise'
  status           String   @default("active") // 'active', 'suspended', 'trial'
  createdAt        DateTime @default(now()) @map("created_at")

  users           User[]
  instances       Instance[]
  campaigns       Campaign[]
  messages        Message[]
  billing         Billing[]
  automationRules AutomationRule[]
  invitations     Invitation[]
  conversations   Conversation[]

  agents          AIAgent[]
  lifecycleStages LifecycleStage[]
  contactFields   ContactField[]
  integrations    Integration[]
  workflows       Workflow[]

  contacts      Contact[]
  contactLabels ContactLabel[]
  activityLogs  ActivityLog[]

  @@map("tenants")
}

model User {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  email         String   @unique
  passwordHash  String   @map("password_hash")
  role          String // 'admin', 'agent', 'viewer'
  emailVerified Boolean  @default(false) @map("email_verified")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  assignedConversations Conversation[] @relation("AssignedUser")
  sentMessages          ChatMessage[]  @relation("SentMessage")

  @@map("users")
}

model OtpCode {
  id        String   @id @default(uuid())
  email     String
  code      String
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("otp_codes")
}

model Invitation {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  email     String
  role      String   @default("agent")
  invitedBy String   @map("invited_by")
  status    String   @default("pending") // 'pending', 'accepted', 'expired'
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("invitations")
}

model Instance {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  instanceName String   @map("instance_name")
  phoneNumber  String?  @map("phone_number")
  status       String // 'connected', 'disconnected', 'qr_pending'
  qrCode       String?  @map("qr_code") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaigns         Campaign[]
  messages          Message[]
  campaignInstances CampaignInstance[]
  automationRules   AutomationRule[]
  chatMessages      ChatMessage[]

  @@map("instances")
}

model Campaign {
  id                   String    @id @default(uuid())
  tenantId             String    @map("tenant_id")
  instanceId           String?   @map("instance_id") // Made optional for multi-instance campaigns
  name                 String
  messageTemplate      String    @map("message_template") @db.Text
  status               String // 'draft', 'scheduled', 'running', 'completed'
  totalContacts        Int       @default(0) @map("total_contacts")
  sentCount            Int       @default(0) @map("sent_count")
  failedCount          Int       @default(0) @map("failed_count")
  delayMin             Int       @default(5) @map("delay_min") // Min delay in seconds
  delayMax             Int       @default(15) @map("delay_max") // Max delay in seconds
  instanceSwitchCount  Int       @default(50) @map("instance_switch_count") // Switch instance every N messages
  messageRotationCount Int       @default(1) @map("message_rotation_count") // Switch template every N messages
  scheduledAt          DateTime? @map("scheduled_at")
  endAt                DateTime? @map("end_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  mediaUrl             String?   @map("media_url")
  mediaType            String?   @map("media_type")

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  instance          Instance?          @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  messages          Message[]
  campaignInstances CampaignInstance[]
  messageTemplates  MessageTemplate[]
  links             Link[]

  @@map("campaigns")
}

model MessageTemplate {
  id         String @id @default(uuid())
  campaignId String @map("campaign_id")
  content    String @db.Text
  orderIndex Int    @map("order_index")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("message_templates")
}

model CampaignInstance {
  id         String @id @default(uuid())
  campaignId String @map("campaign_id")
  instanceId String @map("instance_id")
  orderIndex Int    @map("order_index")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@map("campaign_instances")
}

model Message {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  campaignId      String?   @map("campaign_id")
  instanceId      String    @map("instance_id")
  recipientNumber String    @map("recipient_number")
  messageText     String    @map("message_text") @db.Text
  status          String // 'pending', 'sent', 'delivered', 'failed', 'cancelled'
  failReason      String?   @map("fail_reason") @db.Text
  sentAt          DateTime? @map("sent_at")
  deliveredAt     DateTime? @map("delivered_at")
  wamid           String?   @unique @map("wamid") // Evolution API Message ID
  mediaUrl        String?   @map("media_url")
  mediaType       String?   @map("media_type")
  variables       Json?     @map("variables")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  instance Instance  @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  links    Link[]

  @@map("messages")
}

model Billing {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  periodStart   DateTime @map("period_start") @db.Date
  periodEnd     DateTime @map("period_end") @db.Date
  messagesCount Int      @default(0) @map("messages_count")
  amountDue     Decimal  @map("amount_due") @db.Decimal(10, 2)
  status        String // 'pending', 'paid', 'overdue'

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("billing")
}

model AutomationRule {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  instanceId   String   @map("instance_id")
  name         String
  triggerType  String   @map("trigger_type") // 'keyword', 'any_message', 'welcome'
  triggerValue String?  @map("trigger_value") // keyword to match (if triggerType is 'keyword')
  responseText String   @map("response_text") @db.Text
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@map("automation_rules")
}

model Conversation {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  contactNumber String    @map("contact_number")
  contactName   String?   @map("contact_name")
  lastMessage   String?   @map("last_message") @db.Text
  lastMessageAt DateTime? @map("last_message_at")
  unreadCount   Int       @default(0) @map("unread_count")
  status        String    @default("open") // open, closed, pending
  labels        String[] // "vip", "new", "spam", etc.

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  currentAgentId String?
  currentAgent   AIAgent? @relation("CurrentAgent", fields: [currentAgentId], references: [id])

  assignedUserId String?
  assignedUser   User?   @relation("AssignedUser", fields: [assignedUserId], references: [id])

  agentHistory ConversationAgent[]

  lifecycleStageId String?
  lifecycleStage   LifecycleStage? @relation(fields: [lifecycleStageId], references: [id])

  aiEnabled        Boolean   @default(true)
  escalated        Boolean   @default(false)
  escalatedAt      DateTime?
  escalationReason String?

  failedAttempts    Int       @default(0)
  lastBotResponseAt DateTime?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, contactNumber])
  @@index([tenantId, lastMessageAt(sort: Desc)])
  @@map("conversations")
}

model ChatMessage {
  id              String   @id @default(uuid())
  conversationId  String   @map("conversation_id")
  instanceId      String?  @map("instance_id")
  direction       String // 'incoming' or 'outgoing'
  senderNumber    String   @map("sender_number")
  recipientNumber String   @map("recipient_number")
  messageType     String   @default("text") @map("message_type")
  content         String?  @db.Text
  mediaUrl        String?  @map("media_url")
  wamid           String?  @unique
  status          String   @default("pending")
  createdAt       DateTime @default(now()) @map("created_at")

  senderUserId String? @map("sender_user_id")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  instance     Instance?    @relation(fields: [instanceId], references: [id])
  senderUser   User?        @relation("SentMessage", fields: [senderUserId], references: [id])

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

model Link {
  id          String   @id @default(uuid())
  originalUrl String   @map("original_url")
  shortCode   String   @unique @map("short_code")
  campaignId  String   @map("campaign_id")
  messageId   String?  @map("message_id") // Optional for per-user tracking
  clicks      Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  campaign    Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  message     Message?     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  clickEvents ClickEvent[]

  @@map("links")
}

model ClickEvent {
  id        String   @id @default(uuid())
  linkId    String   @map("link_id")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  device    String? // 'mobile', 'desktop', 'tablet'
  clickedAt DateTime @default(now()) @map("clicked_at")

  link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@map("click_events")
}

// AI Agent Configuration
model AIAgent {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  description String? @db.Text
  avatar      String?

  templateType String? // "receptionist", "sales", "support", "custom"

  instructions String @db.Text

  aiProvider  String @default("deepseek")
  aiModel     String @default("deepseek-chat")
  temperature Float  @default(0.7)
  maxTokens   Int    @default(500)

  greeting      String? @db.Text
  tone          String  @default("professional")
  responseStyle String  @default("concise")

  useHistory    Boolean @default(true)
  historyLength Int     @default(10)

  followUpEnabled Boolean @default(false)
  followUpDelay   Int     @default(300)
  followUpMessage String? @db.Text

  workingHoursEnabled Boolean @default(false)
  workingHours        Json?
  outOfHoursMessage   String? @db.Text

  isActive Boolean @default(true)
  priority Int     @default(0)

  // Phase 4: Action & Group Extensions
  actionConfig       Json?
  allowGroupResponse Boolean  @default(false)
  allowedGroups      String[] @default([])

  actions              AgentAction[]
  knowledgeSources     AgentKnowledge[]
  routingRules         AgentRoutingRule[]  @relation("FromAgent")
  routingRulesTo       AgentRoutingRule[]  @relation("ToAgent")
  conversations        ConversationAgent[]
  currentConversations Conversation[]      @relation("CurrentAgent")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, isActive])
  @@index([tenantId, templateType])
}

// Agent Actions (Close conversation, assign, update lifecycle, etc.)
model AgentAction {
  id      String  @id @default(uuid())
  agentId String
  agent   AIAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  type         String // "close_conversation", "assign_to_agent", "assign_to_team", "update_lifecycle", "add_tag"
  isEnabled    Boolean @default(true)
  config       Json // Action-specific configuration
  instructions String  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId, type])
}

// Knowledge Base (RAG)
model AgentKnowledge {
  id      String  @id @default(uuid())
  agentId String
  agent   AIAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  title   String
  content String @db.Text

  sourceType String  @default("text") // "text", "url", "file"
  sourceUrl  String?
  fileKey    String? // MinIO storage key

  category   String?
  tags       String[]
  chunkIndex Int      @default(0) // For multi-chunk documents

  embedding Unsupported("vector(768)")? // nomic-embed-text embeddings

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId, isActive])
}

// Agent Routing Rules
model AgentRoutingRule {
  id          String  @id @default(uuid())
  fromAgentId String
  fromAgent   AIAgent @relation("FromAgent", fields: [fromAgentId], references: [id], onDelete: Cascade)

  toAgentId String?
  toAgent   AIAgent? @relation("ToAgent", fields: [toAgentId], references: [id])

  toTeamId String?
  toUserId String?

  triggerType    String // "keywords", "intent", "failed_attempts", "manual"
  keywords       String[]
  minConfidence  Float?
  failedAttempts Int?

  priority Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fromAgentId, isActive])
}

// Track which agents handled conversations
model ConversationAgent {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  agentId String
  agent   AIAgent @relation(fields: [agentId], references: [id])

  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  handoffReason String?
  messagesCount Int       @default(0)
  successful    Boolean   @default(true)

  @@index([conversationId])
  @@index([agentId])
}

// CRM: Contact
model Contact {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  phoneNumber  String    @map("phone_number")
  name         String?
  email        String?
  gender       String? // 'male', 'female'
  birthDate    DateTime? @map("birth_date") @db.Date
  governorate  String?
  district     String?
  address      String?   @db.Text
  source       String    @default("manual") // 'whatsapp', 'manual', 'import', 'website'
  customFields Json?     @map("custom_fields")

  lifecycleStageId String?         @map("lifecycle_stage_id")
  lifecycleStage   LifecycleStage? @relation(fields: [lifecycleStageId], references: [id])

  labels       ContactLabelAssignment[]
  notes        ContactNote[]
  activityLogs ActivityLog[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, phoneNumber])
  @@index([tenantId, lifecycleStageId])
  @@map("contacts")
}

// CRM: Label definitions per tenant
model ContactLabel {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name  String
  color String @default("#6366f1")

  assignments ContactLabelAssignment[]

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([tenantId, name])
  @@map("contact_labels")
}

// CRM: Many-to-many Contact <-> Label
model ContactLabelAssignment {
  contactId String  @map("contact_id")
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  labelId String       @map("label_id")
  label   ContactLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now()) @map("assigned_at")

  @@id([contactId, labelId])
  @@map("contact_label_assignments")
}

// CRM: Notes per contact
model ContactNote {
  id        String  @id @default(uuid())
  contactId String  @map("contact_id")
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  userId  String @map("user_id")
  content String @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  @@index([contactId])
  @@map("contact_notes")
}

// Activity Log (for CRM timeline + chat banners)
model ActivityLog {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  contactId String?  @map("contact_id")
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  conversationId String? @map("conversation_id")
  userId         String? @map("user_id") // null = AI agent
  agentId        String? @map("agent_id")

  actionType  String @map("action_type") // 'lifecycle_change', 'label_added', 'label_removed', 'note_added', 'assigned', 'closed', 'tool_email', 'tool_calendar', 'tool_whatsapp'
  description String @db.Text
  metadata    Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, contactId, createdAt(sort: Desc)])
  @@index([tenantId, conversationId, createdAt(sort: Desc)])
  @@map("activity_logs")
}

// Lifecycle Stages (Lead stages)
model LifecycleStage {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name  String
  emoji String?
  color String?
  order Int     @default(0)

  conversations Conversation[]
  contacts      Contact[]

  createdAt DateTime @default(now())

  @@index([tenantId, order])
}

// Contact Custom Fields
model ContactField {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  contactNumber String
  fieldName     String
  fieldValue    String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, contactNumber, fieldName])
  @@index([tenantId, contactNumber])
}

// Integrations (Google Sheets, SMTP, etc.)
model Integration {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  type        String // google_sheets, smtp, webhook
  name        String
  credentials String @db.Text // Encrypted JSON
  status      String @default("active") // active, error, revoked

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, type])
}

// Workflows
model Workflow {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name          String
  description   String?
  triggerType   String // agent_action, manual, webhook
  triggerConfig String? @db.Text // JSON config for trigger

  steps    String  @db.Text // JSON array of steps: [{ action: "sheets.append", params: {...} }]
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  executions WorkflowExecution[]

  @@index([tenantId, isActive])
}

// Workflow Execution History
model WorkflowExecution {
  id         String   @id @default(uuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  conversationId String? // Optional context

  status String // pending, success, failed
  input  String? @db.Text // JSON input
  output String? @db.Text // JSON output result
  error  String? @db.Text

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  logs WorkflowLog[]

  @@index([workflowId, status])
}

model WorkflowLog {
  id          String            @id @default(uuid())
  executionId String
  execution   WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  level     String // info, error
  message   String
  details   String?  @db.Text // JSON
  timestamp DateTime @default(now())

  @@index([executionId])
}
